# 봇 서비스 하나의 환경 — 뜻은 라이브러리의 DEPLOY.md.

# 볼륨 이름이 여기서 나온다(<이름>_bot-state). 바꾸면 빈 상태로 새로 선다.
COMPOSE_PROJECT_NAME=bot

BOT_NAME=bot
BOT_IMAGE=bot:local
BOT_BIND=127.0.0.1:8080
BOT_PUBLIC_ORIGIN=https://bot.example.net
# 링크 망(docker-compose.link.yml)을 쓸 때만.
BOT_CORE_NETWORK=miniwiki

# 봉인 열쇠 — openssl rand -base64 48. 잃으면 맡은 것을 전부 잃는다.
BOT_SECRET=
# 가입에 쓰는 깃허브 OAuth App. 콜백은 {BOT_PUBLIC_ORIGIN}/auth/github/callback
BOT_GITHUB_CLIENT_ID=
BOT_GITHUB_CLIENT_SECRET=

BOT_POLL_SECONDS=30
BOT_MAX_PER_ACCOUNT=3
BOT_DRY_RUN=false
